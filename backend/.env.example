# ─────────────────────────────────────────────────────────────
# RIVO Backend — Environment Variables Template
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────
# PostgreSQL + PostGIS (required)
DATABASE_URL=postgresql+asyncpg://rivo:rivo_password@localhost:5432/rivo_db
DATABASE_SYNC_URL=postgresql+psycopg2://rivo:rivo_password@localhost:5432/rivo_db

# ── Cache ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# Route cache TTL (seconds)
ROUTE_CACHE_TTL=3600
RENTAL_CACHE_TTL=900

# ── Routing providers ─────────────────────────────────────────
# Leave blank to use OTP-only / mock mode
GOOGLE_ROUTES_API_KEY=

# OpenTripPlanner endpoint (local docker or remote)
OTP_BASE_URL=http://localhost:8080/otp

# ── Rental providers ─────────────────────────────────────────
# Set RENTAL_PROVIDER to one of: mock | open_dataset | licensed
RENTAL_PROVIDER=mock

# Licensed provider (fill if RENTAL_PROVIDER=licensed)
LICENSED_RENTAL_API_KEY=
LICENSED_RENTAL_BASE_URL=

# ── Places / Facilities ───────────────────────────────────────
# Optional Google Places API for pharmacies/POI enrichment
GOOGLE_PLACES_API_KEY=

# ── Fuel prices ───────────────────────────────────────────────
# Default petrol price INR/litre (updated periodically or via API)
DEFAULT_PETROL_PRICE_INR=105.0
DEFAULT_DIESEL_PRICE_INR=92.0

# ── ML model paths ────────────────────────────────────────────
RENT_MODEL_PATH=data/models/rent_model.joblib

# ── Data directories ──────────────────────────────────────────
SEED_DATA_DIR=data/seed
FIXTURE_DATA_DIR=data/fixtures

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
