# ─────────────────────────────────────────────────────────────────────
# RIVO Backend — Environment Variables Template (Phase 3)
# ─────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# The application logs "CONFIGURED / NOT CONFIGURED" at startup but
# NEVER logs or prints actual key values.
# ─────────────────────────────────────────────────────────────────────

# ── Application ─────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO

# ── Database ────────────────────────────────────────────────────────
# PostgreSQL + PostGIS (required for full spatial features)
DATABASE_URL=postgresql+asyncpg://rivo:rivo_password@localhost:5432/rivo_db
DATABASE_SYNC_URL=postgresql+psycopg2://rivo:rivo_password@localhost:5432/rivo_db

# ── Cache ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# Route cache TTL (seconds)
# Google LIVE routes: short TTL (respect Google ToS — no indefinite storage)
ROUTE_CACHE_TTL=3600
# Rental listing cache TTL
RENTAL_CACHE_TTL=900

# ── Google APIs ─────────────────────────────────────────────────────
# Configuration is deterministic: loaded automatically from backend/.env
# regardless of whether commands run from repo root or backend/ directory.
#
# Phase 3/6: Live multimodal transit routing via Google Routes API v2 (computeRoutes).
# Leave blank → fallback chain: GTFS → OTP → Mock (labelled ESTIMATED)
GOOGLE_ROUTES_API_KEY=

# Phase 3/6: Live facility search via Google Places API New (places:searchNearby).
# Leave blank → local verified seed data (labelled PERIODIC)
GOOGLE_PLACES_API_KEY=

# ── Phase 7: Live API Safety Switch & Quota Budgets ────────────────
# Set to true ONLY when you intentionally wish to make real external Google API calls.
# Keep false during development and normal pytest to protect API quotas.
RIVO_LIVE_API_TESTS=false
ROUTE_SEARCH_BUDGET=10
PLACES_SEARCH_BUDGET=8
DETAILED_ROUTE_BUDGET=5
FAMILY_ROUTE_BUDGET=6

# ── Routing fallback ────────────────────────────────────────────────
# OpenTripPlanner endpoint (local docker or remote)
OTP_BASE_URL=http://localhost:8080/otp

# ── Rental providers ────────────────────────────────────────────────
# Set RENTAL_PROVIDER to one of: mock | open_dataset | licensed
# mock         → clearly-labelled SAMPLE DATA (always available)
# open_dataset → openly licensed dataset
# licensed     → requires LICENSED_RENTAL_API_KEY + permitted terms
RENTAL_PROVIDER=mock

# Licensed provider (fill if RENTAL_PROVIDER=licensed)
LICENSED_RENTAL_API_KEY=
LICENSED_RENTAL_BASE_URL=

# ── Fuel prices ─────────────────────────────────────────────────────
# Default petrol price INR/litre (updated periodically or via official API)
DEFAULT_PETROL_PRICE_INR=105.0
DEFAULT_DIESEL_PRICE_INR=92.0

# ── ML model paths ──────────────────────────────────────────────────
RENT_MODEL_PATH=data/models/rent_model.joblib

# ── Data directories ────────────────────────────────────────────────
SEED_DATA_DIR=data/seed
FIXTURE_DATA_DIR=data/fixtures

# ── CORS ────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
