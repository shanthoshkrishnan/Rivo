# ─────────────────────────────────────────────────────────────
# RIVO Frontend — Environment Variables Template
# ─────────────────────────────────────────────────────────────

# Google Maps JavaScript API browser key
# Restrict this key in Google Cloud Console to your frontend domains:
#   http://localhost:5173/*, http://localhost:3000/*
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_javascript_api_key_here

# CARTO Basemaps API key (removes watermark on Voyager raster tiles)
VITE_CARTO_API_KEY=your_carto_basemaps_api_key_here
